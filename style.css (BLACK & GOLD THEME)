body{
    margin:0;
    font-family:Arial;
    background:black;
    color:gold;
    text-align:center;
}

.container{
    padding:20px;
}

.card{
    max-width:600px;
    margin:auto;
    padding:20px;
    border:2px solid gold;
    border-radius:15px;
    background:#0d0d0d;
}

.bismillah{
    font-size:18px;
}

.dua, .bless{
    font-size:14px;
}

.couple-img{
    width:100%;
    border-radius:15px;
    margin:15px 0;
    border:2px solid gold;
}

.names{
    font-size:22px;
}

.story{
    font-style:italic;
}

.countdown{
    margin:15px 0;
    padding:10px;
    border:1px solid gold;
}

#timer{
    font-size:20px;
    font-weight:bold;
}

.details{
    margin:15px 0;
    line-height:1.8;
}

button{
    background:gold;
    color:black;
    padding:10px 15px;
    border:none;
    border-radius:8px;
    cursor:pointer;
    font-weight:bold;
}

button:hover{
    background:#ffd700;
}

.footer{
    margin-top:15px;
}
